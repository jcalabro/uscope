{
	"version": "0.2.0",
	"configurations": [
	
		{
			"name": "Debug microscope",
			"type": "lldb",
			"request": "launch",
			"preLaunchTask": "build in Nix dev shell",
			"cargo": {
				"args": [
					"run",
					"--bin=microscope"
				]
			},
			"args": [
				"./build/test-programs/step"
			]
		},
		// Test programs to debug with the microscope extension (editors/vscode).
		{
			"name": "C: segfault with worker threads",
			"type": "microscope",
			"request": "launch",
			"preLaunchTask": "build in Nix dev shell",
			"program": "${workspaceFolder}/build/test-programs/crash-gcc-o0",
			"args": ["segv"],
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "C: core dump of that segfault",
			"type": "microscope",
			"request": "attach",
			"preLaunchTask": "build in Nix dev shell",
			"coreFile": "${workspaceFolder}/build/test-programs/crash-gcc-o0-segv.core",
			"program": "${workspaceFolder}/build/test-programs/crash-gcc-o0"
		},
		{
			"name": "Go: nil pointer dereference",
			"type": "microscope",
			"request": "launch",
			"preLaunchTask": "build in Nix dev shell",
			"program": "${workspaceFolder}/build/test-programs/crash-go-o0",
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "Rust: write to an unmapped address",
			"type": "microscope",
			"request": "launch",
			"preLaunchTask": "build in Nix dev shell",
			"program": "${workspaceFolder}/build/test-programs/crash-rust-o0",
			"cwd": "${workspaceFolder}"
		},
		{
			// Runs to its exit unless stopped: break in tests/fixtures/rust/variables.rs
			// at line 33 for scalars, or line 80 for pointers, structs, and slices.
			"name": "Rust: variables",
			"type": "microscope",
			"request": "launch",
			"preLaunchTask": "build in Nix dev shell",
			"program": "${workspaceFolder}/build/test-programs/variables-rust-o0",
			"cwd": "${workspaceFolder}"
		},
		{
			"name": "C: arguments, environment, and terminal input",
			"type": "microscope",
			"request": "launch",
			"preLaunchTask": "build in Nix dev shell",
			"program": "${workspaceFolder}/build/test-programs/process-environment",
			"args": ["hello", "world"],
			"env": { "MICROSCOPE_FIXTURE_VALUE": "from launch.json" },
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal"
		}
	]
}
