uscope-views 1

# Bytes as text in Go. Verified against Go 1.27.1, by
# tests/fixtures/go/stdlib.

# A byte slice is text when its bytes are valid UTF-8 without control
# characters, and its bytes otherwise; its elements are its bytes either
# way.
view go `[]uint8` {
    show sequence(len(self)) for i in range(len(self)) => self[i]
    format self as utf8
}

# A builder's text is its buffer.
view go strings.Builder {
    show text(buf)
}

# A buffer's text is what it has not yet read, from off.
view go bytes.Buffer {
    check off <= len(buf)
    show if off == len(buf) {
        text(buf, 0)
    } else {
        text(&buf[off], len(buf) - off)
    }
}
