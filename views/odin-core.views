uscope-views 1

# Odin's maps and core library. Verified against Odin dev-2026-05 by
# tests/fixtures/odin/containers.odin. Odin's slices, strings, dynamic
# arrays, and unions need no view.

# Every map is `map`. A map's `data` is the address of its storage, whose
# low six bits are the log2 of its capacity, and points to a record whose
# `key` and `value` are the map's. The storage holds a key for each slot, then a value for each,
# then a hash for each, which is 0 for an empty slot and has its top bit set
# for a deleted entry's. Keys and values are packed into cells of 64 bytes,
# as many to a cell as fit, and hashes are 8 to a cell.
view odin map {
    type Key = typeof(data->key)
    type Value = typeof(data->value)
    let bits = (u64)data
    let base = bits & ~63
    let capacity = base == 0 ? 0 : (u64)1 << (bits & 63)
    let key_size = sizeof(Key)
    let keys_per_cell = key_size > 0 && key_size < 64 ? 64 / key_size : 1
    let key_cell = (keys_per_cell * key_size + 63) & ~63
    let value_size = sizeof(Value)
    let values_per_cell = value_size > 0 && value_size < 64 ? 64 / value_size : 1
    let value_cell = (values_per_cell * value_size + 63) & ~63
    let values = base + capacity / keys_per_cell * key_cell + capacity % keys_per_cell * key_size
    let hashes = (u64*)(values + capacity / values_per_cell * value_cell
        + capacity % values_per_cell * value_size)
    check self.len <= capacity
    show map(self.len) for i in range(capacity) if hashes[i] != 0 && hashes[i] >> 63 == 0
        => *(Key*)(base + i / keys_per_cell * key_cell + i % keys_per_cell * key_size)
        : *(Value*)(values + i / values_per_cell * value_cell + i % values_per_cell * value_size)
    field capacity = capacity
}

# A queue is a ring over its dynamic array's elements: element i is at
# (offset + i) modulo their count.
view odin container_queue::Queue {
    let capacity = len(data)
    check self.len <= capacity && (capacity == 0 || offset < capacity)
    show sequence(self.len) for i in range(self.len) => data[(offset + i) % capacity]
    field capacity = capacity
}

view odin container_small_array::Small_Array {
    check self.len >= 0 && self.len <= len(data)
    show sequence(self.len) for i in range(self.len) => data[i]
}

# A builder's text is its buffer's bytes.
view odin strings::Builder {
    show value(buf)
    format self as utf8
}
