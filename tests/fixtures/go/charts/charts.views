uscope-views 1

# A server's counters, drawn by the built-in renderers. Go's own map view
# presents each map's entries.
extend go main.Hits {
    visualize "bar-chart" {
        entries = self
    }
}

extend go main.Bytes {
    visualize "donut-chart" {
        entries = self
    }
}

extend go main.Hours {
    visualize "bar-chart" {
        values = self
        orientation = "vertical"
    }
}
