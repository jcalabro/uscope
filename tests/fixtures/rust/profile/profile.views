uscope-views 1

# A node as the flame graph reads one: its own samples are its value.
view rust profile::Node {
    field name = name
    field value = samples
    field parent = parent
}

extend rust profile::Profile {
    visualize "flame-graph" {
        nodes = nodes
    }
}

extend rust profile::Folded {
    visualize "flame-graph" {
        stacks = self.0
    }
}
